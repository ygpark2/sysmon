apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram
    receivers:
{{#each telegramReceivers}}
      - uid: {{uid}}
        type: telegram
        settings:
          bottoken: "${TELEGRAM_BOT_TOKEN}"
          chatid: "{{chatId}}"
          parse_mode: html
        disableResolveMessage: false
{{/each}}

policies:
  - orgId: 1
    receiver: telegram
    group_by: ["grafana_folder", "alertname"]
    group_wait: 30s
    group_interval: 2m
    repeat_interval: 1h

groups:
  - orgId: 1
    name: log-alerts
    folder: Alerts
    interval: 1m
    rules:
      - uid: opensearch-error-log-alert
        title: "OpenSearch Error Log Alert"
        condition: C
        data:
          - refId: A
            queryType: lucene
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: opensearch-logs
            model:
              refId: A
              queryType: lucene
              query: "severity.text:ERROR OR body:error OR body:Exception OR body:Fail"
              timeField: "@timestamp"
              metrics:
                - id: "1"
                  type: count
              bucketAggs:
                - id: "2"
                  type: date_histogram
                  field: "@timestamp"
                  settings:
                    interval: auto
                    min_doc_count: "0"
          - refId: B
            queryType: ""
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: sum
              settings:
                mode: dropNN
          - refId: C
            queryType: ""
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          summary: "[오류 감지] 에러 로그가 감지되었습니다"
          description: "OpenSearch에서 최근 5분 동안 ERROR 수준 로그가 감지되었습니다."
        labels:
          severity: critical
