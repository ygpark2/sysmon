apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true

{{#if isOpenSearchBackend}}
  - name: OpenSearch
    type: grafana-opensearch-datasource
    access: proxy
    url: https://opensearch:9200
    basicAuth: true
    basicAuthUser: admin
    secureJsonData:
      basicAuthPassword: ${OPENSEARCH_ADMIN_PASSWORD}
    jsonData:
      tlsSkipVerify: true
      timeField: "@timestamp"
      version: 2
{{/if}}
{{#if isLokiBackend}}
  - name: Loki
    type: loki
    access: proxy
    url: http://loki:3100
{{/if}}
