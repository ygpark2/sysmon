global
  log stdout format raw local0

defaults
  mode http
  timeout connect 5s
  timeout client 50s
  timeout server 50s

frontend http_in
  bind *:80
  acl is_ovs hdr(host) -i {{haproxyDomain}}
  use_backend grafana_backend if is_ovs
  default_backend grafana_backend

backend grafana_backend
  server grafana grafana:3000 check
