version: "3.8"

services:
{{#if enableOpenSearch}}
{{#if isSingleNode}}
  opensearch:
    image: ${OPENSEARCH_IMAGE:-opensearchproject/opensearch:3}
    environment:
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD}
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - {{openSearchSingleNodeDataPath}}:/usr/share/opensearch/data
    ports:
      - "9200:9200"
      - "9600:9600"
    networks: [observability]
    deploy:
      restart_policy:
        condition: on-failure

{{else}}
{{#each openSearchNodes}}
  {{name}}:
    image: ${OPENSEARCH_IMAGE:-opensearchproject/opensearch:3}
    environment:
      - cluster.name=opensearch-cluster
      - node.name={{name}}
      - discovery.seed_hosts={{../openSearchSeedHosts}}
      - cluster.initial_master_nodes={{../openSearchMasterNodes}}
      - bootstrap.memory_lock=true
      - OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
      - OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD}
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - {{dataPath}}:/usr/share/opensearch/data
{{#if exposePorts}}
    ports:
      - "9200:9200"
      - "9600:9600"
{{/if}}
    networks: [observability]
    deploy:
      restart_policy:
        condition: on-failure

{{/each}}
{{/if}}
{{/if}}
{{#if enableLoki}}
  loki:
    image: ${LOKI_IMAGE:-grafana/loki:latest}
    command:
      - -config.file=/etc/loki/local-config.yaml
    volumes:
      - {{lokiDataPath}}:/loki
    ports:
      - "3100:3100"
    networks: [observability]
    deploy:
      restart_policy:
        condition: on-failure

{{/if}}
{{#if enableGrafana}}
  grafana:
    image: ${GRAFANA_IMAGE:-grafana/grafana:latest}
    user: "{{grafanaUser}}"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_PLUGINS_PREINSTALL=${GRAFANA_INSTALL_PLUGINS}
      - GF_SERVER_DOMAIN=${GRAFANA_SERVER_DOMAIN}
      - GF_SERVER_ROOT_URL=${GRAFANA_SERVER_ROOT_URL}
      - GF_SMTP_ENABLED=${GRAFANA_SMTP_ENABLED}
      - GF_SMTP_HOST=${GRAFANA_SMTP_HOST}
      - GF_SMTP_USER=${GRAFANA_SMTP_USER}
      - GF_SMTP_PASSWORD=${GRAFANA_SMTP_PASSWORD}
      - GF_SMTP_FROM_ADDRESS=${GRAFANA_SMTP_FROM_ADDRESS}
      - GF_SMTP_FROM_NAME=${GRAFANA_SMTP_FROM_NAME}
      - GF_SMTP_STARTTLS_POLICY=${GRAFANA_SMTP_STARTTLS_POLICY}
{{#if enableOpenSearch}}
      - OPENSEARCH_ADMIN_PASSWORD=${OPENSEARCH_ADMIN_PASSWORD}
{{/if}}
      - TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}
      - TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID:-}
    volumes:
      - {{grafanaDataPath}}:/var/lib/grafana
      - {{grafanaProvisioningPath}}:/etc/grafana/provisioning
{{#unless enableHaproxy}}
    ports:
      - "3000:3000"
{{/unless}}
    networks: [observability]
{{#if hasGrafanaDependsOn}}
    depends_on:
{{#each grafanaDependsOn}}
      - {{this}}
{{/each}}
{{/if}}
    deploy:
      restart_policy:
        condition: on-failure

{{/if}}
{{#if enableHaproxy}}
  haproxy:
    image: ${HAPROXY_IMAGE:-haproxy:3.3-alpine}
    volumes:
      - {{haproxyConfigFile}}:/usr/local/etc/haproxy/haproxy.cfg:ro
    ports:
      - "80:80"
    networks: [observability]
{{#if hasHaproxyDependsOn}}
    depends_on:
{{#each haproxyDependsOn}}
      - {{this}}
{{/each}}
{{/if}}
    deploy:
      restart_policy:
        condition: on-failure

{{/if}}
{{#if enablePrometheus}}
  prometheus:
    image: ${PROMETHEUS_IMAGE:-prom/prometheus:latest}
    user: "{{prometheusUser}}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
    volumes:
      - {{prometheusConfigFile}}:/etc/prometheus/prometheus.yml:ro
      - {{prometheusDataPath}}:/prometheus
    ports:
      - "9090:9090"
    networks: [observability]
    deploy:
      restart_policy:
        condition: on-failure

{{/if}}
{{#if enableOtel}}
  otel-collector:
    image: ${OTEL_COLLECTOR_IMAGE:-otel/opentelemetry-collector-contrib:latest}
    command:
      - --config=/etc/otelcol-contrib/config.yaml
{{#if enableOpenSearch}}
    environment:
      - OPENSEARCH_ADMIN_PASSWORD=${OPENSEARCH_ADMIN_PASSWORD}
{{/if}}
    volumes:
      - {{otelCollectorConfigFile}}:/etc/otelcol-contrib/config.yaml:ro
    ports:
      - "4317:4317" # OTLP gRPC
      - "4318:4318" # OTLP HTTP
      - "8889:8889" # Prometheus scrape endpoint (exporter)
    networks: [observability]
{{#if hasOtelDependsOn}}
    depends_on:
{{#each otelDependsOn}}
      - {{this}}
{{/each}}
{{/if}}
    deploy:
      restart_policy:
        condition: on-failure

{{/if}}
networks:
  observability:
