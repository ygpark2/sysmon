global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
        - localhost:9090

  - job_name: otel-collector
    static_configs:
      - targets:
        - otel-collector:8889

  - job_name: node-exporter
    static_configs:
      - targets:
        - 172.26.10.178:9100
        - 172.26.13.91:9100
        - 172.26.10.45:9100
        - 172.26.6.10:9100

