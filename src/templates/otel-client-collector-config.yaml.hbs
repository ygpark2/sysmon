receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

exporters:
  otlphttp/upstream:
    endpoint: {{otelClientOtlpEndpoint}}

service:
  pipelines:
    traces:
      receivers: [otlp]
      exporters: [otlphttp/upstream]
    metrics:
      receivers: [otlp]
      exporters: [otlphttp/upstream]
    logs:
      receivers: [otlp]
      exporters: [otlphttp/upstream]
